# memoria (dados de exemplo, some ao reiniciar) | firestore
PERCURSO_ARMAZENAMENTO=memoria
# dev (papel escolhido no navegador; só para desenvolvimento) | firebase
PERCURSO_AUTH=dev
# 1 = carrega dados fictícios quando PERCURSO_ARMAZENAMENTO=memoria
PERCURSO_EXEMPLO=1
FIREBASE_PROJECT_ID=
# Caminho para a chave FORA do repositório (ou deixe vazio no Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=
OPENALEX_MAILTO=
CORS_ORIGENS=http://localhost:5173
