rules_version = '2';
// O navegador nunca acessa o Firestore direto: tudo passa pela API (Admin SDK),
// que aplica as permissões por papel. Por isso o acesso de clientes é fechado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
